{
  "rules": {
    "users": {
      ".read": false,
      ".write": false
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && (!data.exists() || data.child('participants').child('0').val() === auth.uid || data.child('participants').child('1').val() === auth.uid)",
        ".write": "auth != null && (newData.child('participants').child('0').val() === auth.uid || newData.child('participants').child('1').val() === auth.uid)"
      }
    },
    "conversationMembers": {
      "$conversationId": {
        ".read": false,
        ".write": false
      }
    },
    "messages": {
      "$conversationId": {
        ".read": "auth != null && (root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true || root.child('conversations').child($conversationId).child('participants').child('0').val() === auth.uid || root.child('conversations').child($conversationId).child('participants').child('1').val() === auth.uid)",
        ".write": "auth != null && (root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true || root.child('conversations').child($conversationId).child('participants').child('0').val() === auth.uid || root.child('conversations').child($conversationId).child('participants').child('1').val() === auth.uid)",
        "$messageId": {
          ".validate": "newData.hasChildren(['senderId', 'receiverId', 'text', 'createdAt']) && newData.child('senderId').val() === auth.uid"
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
