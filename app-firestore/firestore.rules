rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function publicUserFields(data) {
      return data.keys().hasAll(['name', 'photoUrl', 'createdAt'])
        && data.keys().hasOnly(['name', 'photoUrl', 'createdAt']);
    }

    function legacyUserProfileCleanup() {
      return resource.data.keys().hasAny(['uid', 'email', 'phoneNumber', 'birthDate'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'email', 'phoneNumber', 'birthDate'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photoUrl', 'uid', 'email', 'phoneNumber', 'birthDate'
        ]);
    }

    function validNotificationPolicy(policy) {
      return policy in [
        'all_group_messages', 'mentioned_members',
        'direct_messages_only', 'disabled'
      ];
    }

    function validGroup(data) {
      return data.keys().hasAll([
          'id', 'name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit',
          'notificationPolicy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit',
          'notificationPolicy', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.photoUrl is string
        && data.ownerId is string
        && data.memberIds is list
        && data.memberIds.toSet().size() == data.memberIds.size()
        && data.memberIds.size() >= 2
        && data.memberIds.hasAny([data.ownerId])
        && data.memberLimit is int
        && data.memberLimit >= data.memberIds.size()
        && data.notificationPolicy is string
        && validNotificationPolicy(data.notificationPolicy)
        && data.createdAt is int
        && data.updatedAt is int;
    }

    match /users/{uid} {
      // This document is public profile data only. Legacy mixed documents are
      // deliberately unreadable until migrated into the private subcollection.
      allow get: if signedIn()
        && (request.auth.uid == uid || publicUserFields(resource.data));
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && publicUserFields(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == uid
        && publicUserFields(request.resource.data)
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoUrl'])
          // One-time owner-only removal of fields from the previous mixed schema.
          || legacyUserProfileCleanup()
        );
      allow delete: if false;

      match /private/profile {
        // Clients may access only their own private profile. Admin SDK access
        // is reserved for authenticated API endpoints that verify relationships.
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['email', 'phoneNumber', 'birthDate'])
          && request.resource.data.keys().hasOnly(['email', 'phoneNumber', 'birthDate']);
        allow delete: if false;
      }
    }

    // Searchable projection for UsersScreen; contains public fields only.
    match /publicUsers/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasAll(['uid', 'name', 'photoUrl', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photoUrl', 'createdAt']);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photoUrl', 'createdAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoUrl']);
      allow delete: if false;
    }

    // Legacy directory documents contained email. Client access stays closed.
    match /userDirectory/{uid} {
      allow read, write: if false;
    }

    match /directConversations/{conversationId} {
      allow get, list: if signedIn() && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['id', 'type', 'participantIds', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'type', 'participantIds', 'createdAt'])
        && request.resource.data.id == conversationId
        && request.resource.data.type == 'direct'
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds.toSet().size() == 2
        && request.resource.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && conversationId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      allow get, list: if signedIn() && resource.data.memberIds.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && validGroup(request.resource.data)
        && request.resource.data.id == groupId
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == groupId
        && validGroup(request.resource.data);
      allow delete: if false;
    }
  }
}
